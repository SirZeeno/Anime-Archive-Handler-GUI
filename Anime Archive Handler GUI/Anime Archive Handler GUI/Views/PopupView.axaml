<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Anime_Archive_Handler_GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="Anime_Archive_Handler_GUI.Views.PopupView"
        x:DataType="viewModels:PopupViewModel"
        Width="400" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None"
        Title="PopupView">
    <StackPanel Orientation="Vertical">
        <Button Classes="transparentButton" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseButton_Click">
            X
        </Button>
        
        <TextBlock Text="Scan For Animes in Selected Folder/s" FontSize="20" />
        
        <TextBox Watermark="Path to File(s) or Folder(s)" Text="{CompiledBinding PathTextBox}" />
        
        <Button HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <TextBlock Text="Scan" />
        </Button>
    </StackPanel>
</Window>
